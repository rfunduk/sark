# Sark Config
# "${VAR}" will be interpolated from env vars.
# Paths are absolute or relative to this config file.

# Optional, use when behind reverse proxy
url: https://sark.mydomain.com

listen: 0.0.0.0:8080
data_dir: /storage/data
log_level: info

# LLM / Embed providers if using `llm:` pipeline steps, or `embed:`
providers:
  anthropic:
    api_key: "${ANTHROPIC_API_KEY}"
  ollama:
    url: http://localhost:11434
  openai:
    api_key: "${OPENAI_API_KEY}"
  voyage:
    api_key: "${VOYAGE_API_KEY}"

# Embedder spec. Required for `embed:`
embedder:
  provider: ollama
  model: nomic-embed-text
  dim: 768
  defaults:
    chunk: { size: 1024, overlap: 128 }

# `<scope>` is a list. Entries can be:
#   - "*"                — every known plugin, every tool
#   - <plugin>           — that plugin, every tool
#   - {<plugin>: <pat>}  — that plugin, only tools matching the glob(s)
#   - {<plugin>: [<pat>, <pat>...]}
#   - {"*": <pat>|[...]} — all plugins, only matching tools
auth:
  tokens:
    - { name: default, plugins: <scope>, token: "${SARK_TOKEN}" }
  idp:
    issuer: https://accounts.google.com
    client_id: xyz123.apps.googleusercontent.com
    client_secret: "${OIDC_CLIENT_SECRET}"
    audience: "override" # by default -> `client_id` if set, else `sark`

# Plugin map: name → directory. The name is the routing key everywhere
# (URL path `/<name>/mcp`, DB filename, token scopes).
plugins:
  myplugin: /storage/plugins/myplugin
